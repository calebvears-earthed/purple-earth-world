# Purple Earth connection points.
# Copy to .env.local. Leave a line blank to keep that connection off.
# Do not commit real keys. Do not prefix private keys with NEXT_PUBLIC_.

# Set to "final" to hide the draft banner. Leave unset while copy and prices are drafts.
NEXT_PUBLIC_CONTENT_STATUS=draft

# Public site URL used for canonical links. Defaults to https://purpleearth.com.au
NEXT_PUBLIC_SITE_URL=https://purpleearth.com.au

# Shopify Headless. Use the myshopify.com domain.
# The Storefront token is a public token. The Admin token is server only.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-10
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2025-10
# New customer accounts URL, if it is not https://DOMAIN/account
NEXT_PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_URL=

# Klaviyo. Server only. The list receives the founding list and opted-in RSVPs.
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
KLAVIYO_API_REVISION=2024-10-15

# Supabase. Server only. Service role must not be exposed to the browser.
# Expected tables: waitlist, walk_club_rsvps, walk_club_checkins, barefoot_logs.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WAITLIST_TABLE=waitlist
SUPABASE_WALK_TABLE=walk_club_rsvps
SUPABASE_CHECKIN_TABLE=walk_club_checkins
SUPABASE_BAREFOOT_TABLE=barefoot_logs

# Rivo loyalty. Server only.
# Awards stay off until LOYALTY_AWARDS_ENABLED=true, so a key alone does not mint points.
RIVO_API_KEY=
RIVO_API_BASE=https://developer-api.rivo.io/merchant_api/v1
LOYALTY_AWARDS_ENABLED=false

# Judge.me public widget. Both must be set before the widget loads.
NEXT_PUBLIC_JUDGEME_SHOP_DOMAIN=
NEXT_PUBLIC_JUDGEME_PUBLIC_TOKEN=

# Shared secret for automation routes and the review webhook. Server only.
AUTOMATION_SECRET=
# Printed on the Walk Club QR. People at the walk use it to check in.
WALK_CLUB_CHECKIN_TOKEN=
# Incoming Slack webhook for the low stock note. Server only.
SLACK_WEBHOOK_URL=
